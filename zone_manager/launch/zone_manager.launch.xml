<launch>
  <!--
    Zone Manager: conflict detection only.
    Publishes /zone_conflicts with robot_ids[] + action (startPause/stopPause)
    for an external VDA5050 node. Does not publish MQTT itself.
  -->
  <arg name="fleet_states_topic" default="/fleet_states" />
  <arg name="robot_zone_status_topic" default="/robot_zone_status" />
  <arg name="zone_catalog_topic" default="/zone_catalog" />
  <arg name="monitored_task_topic" default="/Monitored_task_details" />
  <arg name="conflict_topic" default="/zone_conflicts" />
  <arg name="replan_candidate_topic" default="/replan_candidate" />
  <arg name="process_period_sec" default="0.04" />
  <arg name="robot_stale_timeout_sec" default="5.0" />
  <arg name="replan_plan_timeout_sec" default="3.0" />
  <arg name="level" default="L1" />

  <node
    pkg="zone_manager"
    exec="zone_manager_node"
    name="zone_manager"
    output="screen">
    <param name="fleet_states_topic" value="$(var fleet_states_topic)" />
    <param name="robot_zone_status_topic" value="$(var robot_zone_status_topic)" />
    <param name="zone_catalog_topic" value="$(var zone_catalog_topic)" />
    <param name="monitored_task_topic" value="$(var monitored_task_topic)" />
    <param name="conflict_topic" value="$(var conflict_topic)" />
    <param name="replan_candidate_topic" value="$(var replan_candidate_topic)" />
    <param name="process_period_sec" value="$(var process_period_sec)" />
    <param name="robot_stale_timeout_sec" value="$(var robot_stale_timeout_sec)" />
    <param name="replan_plan_timeout_sec" value="$(var replan_plan_timeout_sec)" />
    <param name="level" value="$(var level)" />
  </node>
</launch>
