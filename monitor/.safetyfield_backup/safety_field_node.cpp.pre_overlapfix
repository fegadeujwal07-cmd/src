// =============================================================================
// File: monitor/src/safety_field_node.cpp
// =============================================================================
// OBJECTIVE
//   A circular safety field per AMR, centred on the robot's MEASURED position
//   and following it as it moves. When two fields overlap, both are drawn red
//   instead of teal and the conflicting AMR ids are published.
//
// INPUTS
//   /fleet_states            (rmf_fleet_msgs/FleetState) — real robot positions
// OUTPUTS
//   /safety_field_markers    (visualization_msgs/MarkerArray) — the circles
//   /safety_field_conflict   (monitor/SafetyFieldConflict)    — who overlaps
//
// WHY THIS LIVES IN monitor
//   The field must be centred on where the robot actually IS. Only two places
//   in the system carry that: execution (which publishes /fleet_states) and the
//   packages that consume it. It cannot live in RMF core — the schedule node
//   subscribes only to itinerary and negotiation topics and never receives a
//   robot position, which is why the circles RViz draws today sit at the
//   PLANNED position. Measured on 2026-08: "Robot [amr1] is very far
//   [15.0m] from where it is supposed to be" — a safety field 15 m from the
//   robot is worse than none.
//
//   zone_manager has the positions but is the decision layer (it chooses who
//   pauses). Detecting a geometric overlap is an observation, not a decision,
//   so it belongs beside the other observers. monitor already subscribes to
//   /fleet_states and already publishes MarkerArray for /zone_markers.
//
// WHY DetectConflict RATHER THAN A DISTANCE TEST
//   rmf_traffic::DetectConflict::between() is the exact routine the schedule
//   node uses (Node.cpp:137) and that colours the path line red in RViz. Using
//   it keeps this field consistent with RMF's own geometry, and it takes any
//   convex shape — so a non-circular field later needs no new maths here.
//
// THIS NODE IS REPORT-ONLY
//   It publishes markers and ids. It does NOT pause anything. Pausing would
//   mean a second publisher on /zone_conflicts alongside zone_manager, and the
//   robots treat pause as an on/off latch rather than a counter (observed
//   2026-08-22: amr2 received two startPause and one stopPause, and resumed).
//   Two independent pausers on a latch is unsafe until a shared hold-count
//   exists, so that step is deliberately left out.
// =============================================================================

#include <rclcpp/rclcpp.hpp>

#include <rmf_fleet_msgs/msg/fleet_state.hpp>
#include <visualization_msgs/msg/marker_array.hpp>
#include <monitor/msg/safety_field_conflict.hpp>

#include <rmf_traffic/DetectConflict.hpp>
#include <rmf_traffic/Profile.hpp>
#include <rmf_traffic/Trajectory.hpp>
#include <rmf_traffic/geometry/Circle.hpp>

#include <Eigen/Geometry>

#include <chrono>
#include <map>
#include <set>
#include <string>
#include <vector>

namespace monitor {

class SafetyFieldNode : public rclcpp::Node
{
public:
  SafetyFieldNode()
  : Node("safety_field_node")
  {
    // Radius of the teal safety circle, metres. Defaults to RMF's vicinity
    // radius so the field matches what RViz already draws for each robot.
    radius_ = declare_parameter<double>("safety_field_radius", 1.5);

    // Release radius. DetectConflict returns a hard yes/no, so a single radius
    // makes the circles flash and the topic chatter while two robots sit at the
    // boundary. Clearing is tested with a LARGER field, so the robots must
    // separate a little further before the conflict is dropped.
    release_radius_ =
      declare_parameter<double>("safety_field_release_radius", 1.75);
    if (release_radius_ < radius_) {
      RCLCPP_WARN(
        get_logger(),
        "safety_field_release_radius (%.2f) is below safety_field_radius "
        "(%.2f); raising it to the trigger radius. Without hysteresis the "
        "conflict will chatter at the boundary.",
        release_radius_, radius_);
      release_radius_ = radius_;
    }

    frame_id_ = declare_parameter<std::string>("marker_frame_id", "map");
    level_ = declare_parameter<std::string>("level_name", "L1");
    const double rate = declare_parameter<double>("evaluate_rate_hz", 10.0);
    const std::string fleet_topic =
      declare_parameter<std::string>("fleet_states_topic", "/fleet_states");

    // Built once. Footprint and vicinity are the same circle: this node asks a
    // single question — do the two fields overlap — so a separate inner shape
    // would only make DetectConflict run the pair test twice for one answer.
    field_ = make_profile(radius_);
    release_field_ = make_profile(release_radius_);

    fleet_sub_ = create_subscription<rmf_fleet_msgs::msg::FleetState>(
      fleet_topic, rclcpp::SensorDataQoS(),
      [this](rmf_fleet_msgs::msg::FleetState::SharedPtr msg)
      {
        on_fleet_state(std::move(msg));
      });

    markers_pub_ = create_publisher<visualization_msgs::msg::MarkerArray>(
      "/safety_field_markers", rclcpp::QoS(10));
    conflict_pub_ = create_publisher<monitor::msg::SafetyFieldConflict>(
      "/safety_field_conflict", rclcpp::QoS(10));

    timer_ = create_wall_timer(
      std::chrono::duration_cast<std::chrono::nanoseconds>(
        std::chrono::duration<double>(1.0 / (rate > 0.0 ? rate : 10.0))),
      [this]() { evaluate(); });

    RCLCPP_INFO(
      get_logger(),
      "Safety fields: radius %.2f m (release %.2f m), evaluated at %.1f Hz "
      "from %s. Markers on /safety_field_markers, conflicts on "
      "/safety_field_conflict. Report-only: this node does not pause robots.",
      radius_, release_radius_, rate, fleet_topic.c_str());
  }

private:
  struct RobotPose
  {
    double x{0.0};
    double y{0.0};
    double yaw{0.0};
    rclcpp::Time stamp;
  };

  static rmf_traffic::Profile make_profile(double r)
  {
    auto shape = rmf_traffic::geometry::make_final_convex<
      rmf_traffic::geometry::Circle>(r);
    return rmf_traffic::Profile{shape, shape};
  }

  // A two-point "the robot is here, now" trajectory. DetectConflict sweeps the
  // profile along a trajectory, so a stationary one reduces the sweep to a
  // plain overlap test at the current position — which is exactly the question
  // a safety field asks. The duration only has to be non-zero; both samples
  // share the same position and zero velocity.
  static rmf_traffic::Trajectory hold_at(
    const RobotPose & p, rmf_traffic::Time t)
  {
    rmf_traffic::Trajectory hold;
    const Eigen::Vector3d position{p.x, p.y, p.yaw};
    const Eigen::Vector3d velocity = Eigen::Vector3d::Zero();
    hold.insert(t, position, velocity);
    hold.insert(t + std::chrono::milliseconds(100), position, velocity);
    return hold;
  }

  void on_fleet_state(rmf_fleet_msgs::msg::FleetState::SharedPtr msg)
  {
    if (!msg) {
      return;
    }
    for (const auto & robot : msg->robots) {
      if (robot.name.empty()) {
        continue;
      }
      // Ignore robots reported on another level; their fields cannot overlap
      // ours in any meaningful sense.
      if (!robot.location.level_name.empty() &&
        robot.location.level_name != level_)
      {
        continue;
      }
      RobotPose p;
      p.x = robot.location.x;
      p.y = robot.location.y;
      p.yaw = robot.location.yaw;
      p.stamp = now();
      poses_[robot.name] = p;
    }
  }

  bool fields_overlap(
    const RobotPose & a, const RobotPose & b,
    const rmf_traffic::Profile & profile) const
  {
    const auto t = rmf_traffic::Time(std::chrono::nanoseconds(now().nanoseconds()));
    const auto ta = hold_at(a, t);
    const auto tb = hold_at(b, t);
    return rmf_traffic::DetectConflict::between(
      profile, ta, nullptr,
      profile, tb, nullptr).has_value();
  }

  void evaluate()
  {
    // A robot that has stopped reporting must not keep a stale field sitting on
    // the map; drop it rather than testing a position that may be minutes old.
    drop_stale_poses();

    std::vector<std::string> names;
    names.reserve(poses_.size());
    for (const auto & [name, pose] : poses_) {
      (void)pose;
      names.push_back(name);
    }

    std::vector<std::string> pair_a;
    std::vector<std::string> pair_b;
    std::set<std::string> conflicting;

    for (std::size_t i = 0; i < names.size(); ++i) {
      for (std::size_t j = i + 1; j < names.size(); ++j) {
        const auto & a = poses_.at(names[i]);
        const auto & b = poses_.at(names[j]);

        const bool was_conflicting =
          previous_pairs_.count(pair_key(names[i], names[j])) > 0;

        // Hysteresis: a pair that is already in conflict is tested against the
        // LARGER release field, so it stays in conflict until the robots have
        // separated past the trigger distance rather than flipping the moment
        // they touch it.
        const bool overlap = was_conflicting ?
          fields_overlap(a, b, release_field_) :
          fields_overlap(a, b, field_);

        if (overlap) {
          pair_a.push_back(names[i]);
          pair_b.push_back(names[j]);
          conflicting.insert(names[i]);
          conflicting.insert(names[j]);
        }
      }
    }

    publish_markers(conflicting);
    publish_conflict(conflicting, pair_a, pair_b);

    previous_pairs_.clear();
    for (std::size_t k = 0; k < pair_a.size(); ++k) {
      previous_pairs_.insert(pair_key(pair_a[k], pair_b[k]));
    }
  }

  void drop_stale_poses()
  {
    const auto cutoff = now() - rclcpp::Duration::from_seconds(stale_after_sec_);
    for (auto it = poses_.begin(); it != poses_.end(); ) {
      if (it->second.stamp < cutoff) {
        RCLCPP_INFO(
          get_logger(),
          "Dropping safety field for %s: no /fleet_states update for %.0fs",
          it->first.c_str(), stale_after_sec_);
        it = poses_.erase(it);
      } else {
        ++it;
      }
    }
  }

  static std::string pair_key(const std::string & a, const std::string & b)
  {
    return (a < b) ? (a + "|" + b) : (b + "|" + a);
  }

  void publish_markers(const std::set<std::string> & conflicting)
  {
    visualization_msgs::msg::MarkerArray array;
    int id = 0;
    for (const auto & [name, pose] : poses_) {
      visualization_msgs::msg::Marker m;
      m.header.frame_id = frame_id_;
      m.header.stamp = now();
      m.ns = "safety_field";
      m.id = id++;
      m.type = visualization_msgs::msg::Marker::CYLINDER;
      m.action = visualization_msgs::msg::Marker::ADD;
      m.pose.position.x = pose.x;
      m.pose.position.y = pose.y;
      m.pose.position.z = 0.0;
      m.pose.orientation.w = 1.0;
      // Diameter, so the drawn circle is the field the test actually uses.
      m.scale.x = 2.0 * radius_;
      m.scale.y = 2.0 * radius_;
      m.scale.z = 0.05;

      const bool in_conflict = conflicting.count(name) > 0;
      m.color.r = in_conflict ? 1.0f : 0.5f;
      m.color.g = in_conflict ? 0.0f : 1.0f;
      m.color.b = in_conflict ? 0.0f : 0.9f;
      m.color.a = 0.5f;

      m.lifetime = rclcpp::Duration::from_seconds(1.0);
      array.markers.push_back(m);
    }

    if (!array.markers.empty() || published_markers_) {
      markers_pub_->publish(array);
      published_markers_ = !array.markers.empty();
    }
  }

  void publish_conflict(
    const std::set<std::string> & conflicting,
    const std::vector<std::string> & pair_a,
    const std::vector<std::string> & pair_b)
  {
    // Publish while any overlap exists, and once more on the falling edge so a
    // consumer sees the clear without polling. Staying silent otherwise keeps
    // the topic readable.
    const bool any = !conflicting.empty();
    if (!any && !had_conflict_) {
      return;
    }

    monitor::msg::SafetyFieldConflict msg;
    msg.stamp = now();
    msg.robot_ids.assign(conflicting.begin(), conflicting.end());
    msg.pair_a = pair_a;
    msg.pair_b = pair_b;
    conflict_pub_->publish(msg);

    if (any != had_conflict_) {
      if (any) {
        std::string pairs;
        for (std::size_t k = 0; k < pair_a.size(); ++k) {
          pairs += (k ? ", " : "") + pair_a[k] + "<->" + pair_b[k];
        }
        RCLCPP_WARN(
          get_logger(),
          "Safety field conflict: %s (radius %.2f m)", pairs.c_str(), radius_);
      } else {
        RCLCPP_INFO(get_logger(), "Safety field conflict cleared");
      }
    }
    had_conflict_ = any;
  }

  double radius_{1.5};
  double release_radius_{1.75};
  double stale_after_sec_{3.0};
  std::string frame_id_{"map"};
  std::string level_{"L1"};
  bool had_conflict_{false};
  bool published_markers_{false};

  rmf_traffic::Profile field_{
    rmf_traffic::geometry::make_final_convex<rmf_traffic::geometry::Circle>(1.5),
    rmf_traffic::geometry::make_final_convex<rmf_traffic::geometry::Circle>(1.5)};
  rmf_traffic::Profile release_field_{
    rmf_traffic::geometry::make_final_convex<rmf_traffic::geometry::Circle>(1.75),
    rmf_traffic::geometry::make_final_convex<rmf_traffic::geometry::Circle>(1.75)};

  std::map<std::string, RobotPose> poses_;
  std::set<std::string> previous_pairs_;

  rclcpp::Subscription<rmf_fleet_msgs::msg::FleetState>::SharedPtr fleet_sub_;
  rclcpp::Publisher<visualization_msgs::msg::MarkerArray>::SharedPtr markers_pub_;
  rclcpp::Publisher<monitor::msg::SafetyFieldConflict>::SharedPtr conflict_pub_;
  rclcpp::TimerBase::SharedPtr timer_;
};

}  // namespace monitor

int main(int argc, char ** argv)
{
  rclcpp::init(argc, argv);
  rclcpp::spin(std::make_shared<monitor::SafetyFieldNode>());
  rclcpp::shutdown();
  return 0;
}
