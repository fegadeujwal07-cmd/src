<?xml version="1.0"?>
<launch>

  <!-- Args -->
  <arg name="use_sim_time" default="false"/>
  <arg name="rate" default="25.0" description="schedule markers publish rate (Hz) - Increased from 20.0 to 25.0 Hz for better position tracking"/>
  <arg name="map_name" default="L1" description="Level to visualize (e.g., L1 or B1)"/>
  <arg name="viz_config_file" default="$(find-pkg-share rmf_visualization)/rmf.rviz"/>
  <arg name="display_names" default="true"/>
  <arg name="websocket_port" default="8006"/>
  <arg name="headless" default="false" description="Do not launch RViz"/>
  <arg name="path_width" default="0.2"/>
  <arg name="lane_width" default="0.5"/>
  <arg name="waypoint_scale" default="1.3"/>
  <arg name="text_scale" default="0.7"/>
  <arg name="lane_transparency" default="0.6"/>
  <arg name="wait_secs" default="10"/>
  <arg name="retained_history_count" default="50"/>
  <arg name="fleet_state_nose_scale" default="0.5"/>
  <arg name="rmf_frame_id" default="map"/>

  <!-- Visualization nodes -->
  <group>

    <!-- Live schedule routes -->
    <node pkg="rmf_visualization_schedule" exec="schedule_visualizer_node" output="screen">
      <param name="use_sim_time" value="$(var use_sim_time)"/>
      <param name="rate" value="$(var rate)"/>
      <param name="path_width" value="$(var path_width)"/>
      <param name="initial_map_name" value="$(var map_name)"/>
      <param name="wait_secs" value="$(var wait_secs)"/>
      <param name="port" value="$(var websocket_port)"/>
      <param name="retained_history_count" value="$(var retained_history_count)"/>
    </node>

    <!-- Fleet markers -->
    <node pkg="rmf_visualization_fleet_states" exec="fleetstates_visualizer_node" output="screen">
      <param name="use_sim_time" value="$(var use_sim_time)"/>
      <param name="fleet_state_nose_scale" value="$(var fleet_state_nose_scale)"/>
      <param name="initial_map_name" value="$(var map_name)"/>
      <!-- example footprint radii -->
      <param name="tinyRobot_radius" value="0.3"/>
      <param name="deliveryRobot_radius" value="0.6"/>
      <param name="cleanerBotA_radius" value="1.0"/>
      <param name="cleanerBotE_radius" value="1.0"/>
      <param name="caddy_radius" value="1.5"/>
    </node>

    <!-- Building systems -->
    <node pkg="rmf_visualization_building_systems" exec="rmf_visualization_building_systems" output="screen">
      <param name="use_sim_time" value="$(var use_sim_time)"/>
      <param name="initial_map_name" value="$(var map_name)"/>
      <remap from="building_map" to="/building_map"/>
      <!--<remap from="map" to="/rmf_viz/map"/>-->
    </node>

    <!-- Static nav-graph (lanes/waypoints) -->
    <node pkg="rmf_visualization_navgraphs" exec="navgraph_visualizer_node" output="screen">
      <param name="use_sim_time" value="$(var use_sim_time)"/>
      <param name="initial_map_name" value="$(var map_name)"/>
      <param name="lane_width" value="$(var lane_width)"/>
      <param name="waypoint_scale" value="$(var waypoint_scale)"/>
      <param name="text_scale" value="$(var text_scale)"/>
      <param name="lane_transparency" value="$(var lane_transparency)"/>
      <!-- UPDATE THIS PATH to your exported TE graph(s); use comma for multiple -->
     <param name="nav_graph_files" value="[/home/apurva/FMS/install/execution/share/execution/config/nav_graphs/0.yaml]"/>
    </node>

    <!-- Floorplan rasterizer -->
    <group>
      <!--<push-ros-namespace namespace="rmf_viz"/>-->
      
      <node pkg="rmf_visualization_floorplans" exec="floorplan_visualizer_node" output="screen">
        <param name="use_sim_time" value="$(var use_sim_time)"/>
        <param name="initial_map_name" value="$(var map_name)"/>
        <remap from="building_map" to="/building_map"/>
      </node>
    </group>

    <!-- Obstacles viz -->
    <node pkg="rmf_visualization_obstacles" exec="obstacle_visualizer_node" output="screen">
      <param name="use_sim_time" value="$(var use_sim_time)"/>
      <param name="initial_map_name" value="$(var map_name)"/>
      <param name="global_fixed_frame" value="$(var rmf_frame_id)"/>
    </node>

  </group>

  <!-- RViz -->
  <group unless="$(var headless)">
    <node pkg="rviz2" exec="rviz2" output="screen" args="-d $(var viz_config_file)"/>
  </group>

</launch>
